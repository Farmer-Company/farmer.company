rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return getUserData().role; }
    function isAdmin() { 
      return isAuthenticated() && (
        role() == 'admin' || 
        (request.auth.token.email == "arunvith6@gmail.com" && request.auth.token.email_verified == true)
      );
    }
    
    // Validate string length helper
    function validString(field, min, max) {
      return request.resource.data[field] is string && 
             request.resource.data[field].size() >= min && 
             request.resource.data[field].size() <= max;
    }

    function betaRoles() {
      return ['farmer', 'vendor', 'logistics', 'government', 'researcher'];
    }

    function validMaybeString(field, max) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function validMaybeNumber(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is number;
    }

    function validEmail(field) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= 5 &&
        request.resource.data[field].size() <= 254 &&
        request.resource.data[field].matches("^[^@ ]+@[^@ ]+\\.[^@ ]+$");
    }

    function validMaybeUid(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (isAuthenticated() && request.resource.data[field] == request.auth.uid);
    }

    function validUserCreate(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'phoneNumber', 'role', 'verified',
          'language_pref', 'region_state', 'region_district',
          'profile_public', 'createdAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.role in betaRoles() &&
        validString('fullName', 1, 120) &&
        validMaybeString('email', 254) &&
        validString('phoneNumber', 8, 20) &&
        request.resource.data.createdAt is timestamp;
    }

    function validUserOwnerUpdate(uid) {
      return request.resource.data.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'email', 'phoneNumber', 'language_pref',
          'region_state', 'region_district', 'profile_public', 'updatedAt'
        ]) &&
        validMaybeString('fullName', 120) &&
        validMaybeString('email', 254) &&
        validMaybeString('phoneNumber', 20);
    }

    function validBetaRegistration() {
      return request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'mobileNumber', 'role', 'timestamp'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in betaRoles() &&
        validString('fullName', 1, 120) &&
        validString('mobileNumber', 8, 20) &&
        request.resource.data.timestamp is timestamp;
    }

    function validTradeIntent() {
      return request.resource.data.keys().hasOnly([
          'type', 'marketId', 'marketName', 'state', 'district',
          'commodityName', 'quantityTonnes', 'contactName', 'phone',
          'targetPrice', 'notes', 'source', 'userId', 'createdAt', 'status'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in ['buy', 'sell'] &&
        request.resource.data.source in ['market_page', 'prices_page'] &&
        request.resource.data.status == 'ops_review' &&
        request.resource.data.marketId is number &&
        validString('marketName', 1, 120) &&
        validString('state', 1, 80) &&
        validString('district', 1, 80) &&
        validString('commodityName', 1, 120) &&
        request.resource.data.quantityTonnes is number &&
        request.resource.data.quantityTonnes > 0 &&
        validString('contactName', 1, 120) &&
        validString('phone', 8, 20) &&
        validMaybeNumber('targetPrice') &&
        validMaybeString('notes', 1000) &&
        request.resource.data.createdAt is timestamp;
    }

    function validCommodityInterest() {
      return request.resource.data.keys().hasOnly([
          'commodityName', 'commodityCode', 'state', 'district', 'intentType',
          'volumeBand', 'contactName', 'organization', 'email', 'phone', 'notes',
          'source', 'userId', 'feedStatus', 'pageUrl', 'referrer', 'userAgent',
          'locale', 'timezone', 'screenSize', 'createdAt', 'status'
        ]) &&
        request.resource.data.source == 'prices_page' &&
        request.resource.data.status == 'ops_review' &&
        request.resource.data.intentType in ['sell', 'buy', 'monitor', 'research'] &&
        request.resource.data.feedStatus in ['pilot_validation', 'queued'] &&
        request.resource.data.volumeBand in [
          'Under 5 MT', '5-25 MT', '25-100 MT', '100+ MT', 'Monitoring only'
        ] &&
        validString('commodityName', 1, 120) &&
        validMaybeString('commodityCode', 20) &&
        validString('state', 1, 80) &&
        validMaybeString('district', 80) &&
        validString('contactName', 1, 120) &&
        validMaybeString('organization', 160) &&
        validEmail('email') &&
        validString('phone', 8, 24) &&
        validMaybeString('notes', 1000) &&
        validMaybeUid('userId') &&
        validMaybeString('pageUrl', 500) &&
        validMaybeString('referrer', 500) &&
        validMaybeString('userAgent', 300) &&
        validMaybeString('locale', 40) &&
        validMaybeString('timezone', 80) &&
        validMaybeString('screenSize', 40) &&
        request.resource.data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow create: if isAuthenticated() && isOwner(uid) && validUserCreate(uid);
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(uid) && validUserOwnerUpdate(uid)));
    }

    match /beta_registrations/{id} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && validBetaRegistration();
      allow update, delete: if isAdmin();
    }

    match /trade_intents/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && validTradeIntent();
      allow update, delete: if isAdmin();
    }

    match /commodity_interests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if validCommodityInterest();
    }

    match /farmers/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isOwner(uid) || isAdmin());
    }

    match /skus/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /production_records/{id} {
      allow read: if isAuthenticated() && (resource.data.farmerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.farmerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.farmerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /listings/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && role() == 'farmer';
      allow update, delete: if isAuthenticated() && (resource.data.farmerId == request.auth.uid || isAdmin());
    }

    match /orders/{id} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        resource.data.logisticsId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (role() == 'vendor' || role() == 'farmer');
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.buyerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus'])) ||
        (resource.data.sellerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
    }

    match /forecasts/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isAuthenticated() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.fromId == request.auth.uid;
    }
  }
}
